#!/bin/bash
#PBS -N cannon-state-ablation
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=03:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/mk27+gdata/y89
#PBS -l wd
#PBS -j oe
#PBS -m bae
#PBS -M maja.jablonska@anu.edu.au

# ===========================================================================
#  Ablate the RGB/HeB classifier's information content -- CPU-only PBS job.
#
#  Runs scripts/compare_state_classifiers.py: fits the same estimator family
#  at three information levels (bulge labels with spectroscopic log g / with
#  seismic log g / production labels + spectral PCA) on the seismically
#  labelled stars of the all-missions sample, scores every one of them
#  out-of-fold against seismic truth, and measures what the bulge feature
#  space costs -- purity, completeness at matched purity, and whether the
#  lost completeness correlates with [C/N] and hence age.
#
#  This is what justifies (or refutes) running a different classifier on the
#  bulge than on the calibration sample. No GPU: sklearn plus one continuum
#  normalization pass, which the NPZ cache makes a one-off. Sized and queued
#  like the repo's other CPU jobs (mk27 on rsaa, 16 cpus / 64 GB) -- dg97
#  pairs with the gpursaa queues here, not with the CPU ones.
#
#  Follows the benchmark's conventions so the numbers are comparable with the
#  Cannon/Lux/BNN runs: cuts and derivations come from stardata, folds are
#  STAR-level and seeded with the benchmark's split seed (42), and repeated
#  (APOGEE_ID, source) rows -- the same spectrum twice -- are dropped.
#
#  Overridable via qsub -v (defaults in brackets):
#    OUT_ROOT    [newest $HOME/scr_mk27/benchmark_v*]  results land in
#                                               $OUT_ROOT/state_ablation/,
#                                               and $OUT_ROOT/dataset supplies
#                                               the merged catalogue + seed
#    STARDIAG    [$HOME/scr_mk27/stardiag]      checkout providing stardata.py
#    SPLIT_SEED  [42]                           fold seed (benchmark default)
#    FOLDS       [5]                            star-level CV folds
#    EXTRA_ARGS  []                             e.g. "--primary-only"
#
#  Submit through the wrapper (never raw qsub -- the shared -M/-m/-j
#  directives live there):
#
#    bash scripts/qsub.sh scripts/compare_state_classifiers.pbs
#    bash scripts/qsub.sh -v OUT_ROOT=$HOME/scr_mk27/benchmark_v8 \
#         scripts/compare_state_classifiers.pbs
# ===========================================================================

set -uo pipefail

# ---- user configuration (override any via `qsub -v KEY=VAL,...`) -----------
PROJECT_DIR="${PBS_O_WORKDIR:-$PWD}"
# The benchmark's own interpreter (stardiag/run_benchmark.pbs), so the
# ablation runs against the same sklearn/pandas the benchmark did -- hence
# the gdata/y89 mount above.
PYTHON_BIN="${PYTHON_BIN:-/g/data/y89/mj8805/miniforge/envs/astro/bin/python}"
DATA_DIR="${DATA_DIR:-$HOME/scr_mk27/bulge-ages-and-orbits/data}"
# The all-missions labels + spectra table the RGB selection was built from --
# the same merged catalogue stardata.build_dataset reads.
SPECTRA="${SPECTRA:-${DATA_DIR}/merged_with_ages_raw.parquet}"
CONTINUUM_LIST="${CONTINUUM_LIST:-${DATA_DIR}/continuum.list}"
# Sit next to the benchmark this is meant to be read alongside. With several
# benchmark_v* around, default to the highest-numbered one that exists rather
# than a version pinned in a comment months ago.
if [ -z "${OUT_ROOT:-}" ]; then
    OUT_ROOT=$(ls -d "$HOME"/scr_mk27/benchmark_v[0-9]* 2>/dev/null \
               | sed 's/.*benchmark_v//' | sort -n | tail -1 \
               | xargs -I{} echo "$HOME/scr_mk27/benchmark_v{}")
    OUT_ROOT="${OUT_ROOT:-$HOME/scr_mk27/benchmark_v8}"
fi
OUTDIR="${OUTDIR:-${OUT_ROOT}/state_ablation}"
# The dataset dir pins the ablation to that benchmark's merged catalogue,
# split seed and fold count (its manifest.json).
DATASET_DIR="${DATASET_DIR:-${OUT_ROOT}/dataset}"
STARDIAG="${STARDIAG:-$HOME/scr_mk27/stardiag}"
# Continuum normalization is the slow step; cache it so re-runs are minutes.
CACHE="${CACHE:-${OUTDIR}/normalized_spectra.npz}"
FOLDS="${FOLDS:-5}"                    # benchmark fold count
SPLIT_SEED="${SPLIT_SEED:-42}"         # benchmark split seed
N_COMPONENTS="${N_COMPONENTS:-50}"     # must match the production classifier
EXTRA_ARGS="${EXTRA_ARGS:-}"
# ---------------------------------------------------------------------------

cd "${PROJECT_DIR}"

if [ ! -f "${STARDIAG}/stardata.py" ]; then
    echo "[$(date)] ERROR: no stardata.py in ${STARDIAG}; pass STARDIAG=..."
    exit 1
fi

for f in "${CONTINUUM_LIST}"; do
    if [ ! -f "${f}" ]; then
        echo "[$(date)] ERROR: missing input ${f}"
        exit 1
    fi
done

mkdir -p "${OUTDIR}"

# Run as `python -m scripts.<name>` from the repo root, as the other jobs do.
export PYTHONPATH="${PROJECT_DIR}:${STARDIAG}:${PYTHONPATH:-}"
# sklearn threading: one process, all cores on this node.
export OMP_NUM_THREADS="${PBS_NCPUS:-12}"
# No GPU on this queue, and jax is only used by the continuum normalization.
export JAX_PLATFORMS=cpu

echo "[$(date)] state-classifier ablation on ${SPECTRA} ($(hostname))"

args=( --continuum-list "${CONTINUUM_LIST}" )
if [ -f "${DATASET_DIR}/manifest.json" ]; then
    echo "[$(date)] inheriting catalogue, split seed and folds from ${DATASET_DIR}"
    args+=( --dataset-dir "${DATASET_DIR}" )
else
    echo "[$(date)] no dataset manifest in ${DATASET_DIR}; using ${SPECTRA}"
    args+=( --spectra "${SPECTRA}" )
fi

${PYTHON_BIN} -m scripts.compare_state_classifiers \
    "${args[@]}" \
    --outdir "${OUTDIR}" \
    --cache "${CACHE}" \
    --folds "${FOLDS}" \
    --split-seed "${SPLIT_SEED}" \
    --n-components "${N_COMPONENTS}" \
    ${EXTRA_ARGS} \
    -v
rc=$?

if [ ${rc} -eq 0 ]; then
    echo "[$(date)] ablation finished; results in ${OUTDIR}"
else
    echo "[$(date)] ablation FAILED with exit code ${rc}"
fi
exit ${rc}
