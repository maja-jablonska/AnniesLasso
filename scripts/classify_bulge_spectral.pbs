#!/bin/bash
#PBS -N cannon-classify-bulge-spectral
#PBS -P mk27
#PBS -q rsaa
#PBS -l ncpus=16
#PBS -l mem=64GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/mk27+scratch/y89+gdata/mk27+gdata/y89
#PBS -l wd
#PBS -j oe
#PBS -m bae
#PBS -M maja.jablonska@anu.edu.au

# ===========================================================================
#  Classify a bulge sample into RGB / RC from its SPECTRA -- CPU-only job.
#
#  Runs scripts/classify_bulge_spectral.py: fits the gradient-boosting +
#  spectral-PCA state classifier on the seismically labelled rows of the
#  calibration sample, then streams the bulge table and classifies it from the
#  same normalized spectra the Cannon and Lux already read to predict its ages.
#
#  Log g is the SPECTROSCOPIC one on both sides -- the one difference the bulge
#  genuinely forces, since no bulge star has a numax. Everything else (grid,
#  continuum list, feature space) matches the calibration-side selection.
#
#  Read the logged CV numbers (accuracy, ROC AUC, purity/completeness at the
#  threshold, clump-box accuracy) before believing the output, and the flip
#  test for how far it moves the sample from the label-only classification.
#
#  Overridable via qsub -v (defaults in brackets):
#    SPECTRA     [$DATA/crossmatched_5.parquet]  bulge table WITH the arrays
#    TRAIN       [$DATA/merged_with_ages_raw.parquet]
#    OUTPUT      [$DATA/rgb_selection_bulge_spectral.parquet]
#    COMPARE     [unset]  label-only classification for the flip test
#    MIN_PROBA   [0.9]    accept as RGB above this p(RGB)
#    BATCH_ROWS  [4000]   spectra normalized+classified per batch
#
#  Submit through the wrapper (never raw qsub):
#
#    bash scripts/qsub.sh scripts/classify_bulge_spectral.pbs
#    bash scripts/qsub.sh -v COMPARE=$HOME/scr_mk27/bingo-modern/RGB_RC_classifier/bulge_rgb_bnn.parquet \
#         scripts/classify_bulge_spectral.pbs
# ===========================================================================

set -uo pipefail

# ---- user configuration (override any via `qsub -v KEY=VAL,...`) -----------
PROJECT_DIR="${PBS_O_WORKDIR:-$PWD}"
PYTHON_BIN="${PYTHON_BIN:-/g/data/y89/mj8805/miniforge/envs/astro/bin/python}"
DATA_DIR="${DATA_DIR:-$HOME/scr_mk27/bulge-ages-and-orbits/data}"
# The bulge table that still carries wavelength/flux/ivar. bulge_5.parquet has
# the arrays DROPPED (it is the orbit-run input) -- crossmatched_5 keeps them.
SPECTRA="${SPECTRA:-${DATA_DIR}/crossmatched_5.parquet}"
TRAIN="${TRAIN:-${DATA_DIR}/merged_with_ages_raw.parquet}"
CONTINUUM_LIST="${CONTINUUM_LIST:-${DATA_DIR}/continuum.list}"
OUTPUT="${OUTPUT:-${DATA_DIR}/rgb_selection_bulge_spectral.parquet}"
COMPARE="${COMPARE:-}"
MIN_PROBA="${MIN_PROBA:-0.9}"
BATCH_ROWS="${BATCH_ROWS:-4000}"
N_COMPONENTS="${N_COMPONENTS:-50}"   # must match the calibration classifier
# ---------------------------------------------------------------------------

cd "${PROJECT_DIR}"

for f in "${SPECTRA}" "${TRAIN}" "${CONTINUUM_LIST}"; do
    if [ ! -f "${f}" ]; then
        echo "[$(date)] ERROR: missing input ${f}"
        exit 1
    fi
done

export PYTHONPATH="${PROJECT_DIR}:${PYTHONPATH:-}"
export OMP_NUM_THREADS="${PBS_NCPUS:-16}"
export JAX_PLATFORMS=cpu          # jax is only used by the continuum fit

args=( --spectra "${SPECTRA}"
       --classifier-train "${TRAIN}"
       --continuum-list "${CONTINUUM_LIST}"
       --output "${OUTPUT}"
       --min-proba "${MIN_PROBA}"
       --batch-rows "${BATCH_ROWS}"
       --n-components "${N_COMPONENTS}"
       -v )
[ -n "${COMPARE}" ] && args+=( --compare "${COMPARE}" )

echo "[$(date)] spectral RGB/RC classification of ${SPECTRA} ($(hostname))"

${PYTHON_BIN} -m scripts.classify_bulge_spectral "${args[@]}"
rc=$?

if [ ${rc} -eq 0 ]; then
    echo "[$(date)] finished; wrote ${OUTPUT}"
else
    echo "[$(date)] FAILED with exit code ${rc}; no selection written"
fi
exit ${rc}
